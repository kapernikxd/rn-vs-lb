{
  "name": "rn-vs-lb",
  "version": "1.0.56",
  "description": "React Native component library with an Expo-powered Storybook sandbox.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "react-native": "dist/index.js",
  "source": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "storybook": "expo start --clear",
    "storybook-generate": "sb-rn-get-stories --config-path ./.storybook",
    "clean": "rimraf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "react-native",
    "storybook",
    "design-system"
  ],
  "author": "",
  "license": "ISC",
  "typesVersions": {
    "*": {
      "form": [
        "dist/types/form/index.d.ts"
      ],
      "constants": [
        "dist/types/constants/index.d.ts"
      ],
      "*": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./form": {
      "types": "./dist/types/form/index.d.ts",
      "import": "./dist/form/index.js",
      "require": "./dist/form/index.js"
    },
    "./constants": {
      "types": "./dist/types/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "require": "./dist/constants/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@gorhom/bottom-sheet": ">=5.0.5",
    "@react-native-async-storage/async-storage": ">=1.24.0",
    "@react-native-community/datetimepicker": ">=8.2.0",
    "@react-native-picker/picker": ">=2.7.7",
    "expo": ">=51.0.0",
    "expo-image-picker": ">=15.0.7",
    "react": ">=18.0.0",
    "react-hook-form": ">=7.53.0",
    "react-native": ">=0.74.0",
    "react-native-autocomplete-input": ">=5.4.0",
    "react-native-gesture-handler": ">=2.20.2",
    "react-native-reanimated": ">=3.10.1",
    "react-native-vector-icons": ">=10.1.0"
  },
  "dependencies": {
    "axios": "^1.7.5",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-community/slider": "^4.5.2",
    "@storybook/addon-ondevice-actions": "^7.6.20",
    "@storybook/addon-ondevice-controls": "^7.6.20",
    "@storybook/react-native": "^7.6.20",
    "@svgr/cli": "^8.1.0",
    "@types/react": "~18.2.45",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-loader": "^8.3.0",
    "expo": "~51.0.28",
    "react-dom": "^18.3.1",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-web": "~0.19.10",
    "rimraf": "^5.0.5",
    "typescript": "^5.1.3"
  }
}
